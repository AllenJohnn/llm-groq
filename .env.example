# ==========================================
# LLM ShardX Environment Configuration Template
# Copy this file to .env and configure your variables
# ==========================================

# Groq API Configuration for Groq Cloud mode
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Local WebGPU inference is the default. Set true to start in Groq Cloud mode instead.
FALLBACKMODE=false

# Local Development & Demonstration Server Ports
PORT=8080
SIGNAL_PORT=9000
HOST=0.0.0.0
