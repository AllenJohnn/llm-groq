# ==========================================
# LLM ShardX Environment Configuration Template
# Copy this file to .env and configure your variables
# ==========================================

# Groq API Configuration for Groq Cloud mode
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Local WebGPU inference is the default. Set true to start in Groq Cloud mode instead.
FALLBACKMODE=false

# Local Development & Demonstration Server Ports
PORT=8080
SIGNAL_PORT=9000
HOST=0.0.0.0

# Optional stable Cloudflare Tunnel for npm run demo.
# In the tunnel's dashboard, route these hostnames to the web and signaling ports:
# CLOUDFLARE_ROOM_URL=https://room.yourdomain.com
# CLOUDFLARE_SIGNAL_HOST=signal.yourdomain.com
# Use a newly rotated tunnel token, keep it only in your ignored .env file:
# CLOUDFLARE_TUNNEL_TOKEN=replace_with_rotated_token
